// An HMAC instance that uses SHA256 as a hash function.
module Minilib.Crypto.HMAC.HmacSHA256;

import Minilib.Crypto.HMAC::{HMAC, HMAC::make};
import Minilib.Crypto.SHA256::digest;

// An HMAC instance that uses SHA256 as a hash function.
hmac_sha256: HMAC;
hmac_sha256 = HMAC::make(SHA256::digest, 64, 32);

